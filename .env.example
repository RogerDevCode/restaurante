# Copia este archivo a .env y cambia las contraseñas para tu entorno local.
MYSQL_DATABASE=restaurante
MYSQL_USER=restaurante_app
MYSQL_PASSWORD=CAMBIAR_POR_CLAVE_LOCAL_APP
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_CLAVE_LOCAL_ROOT
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Obligatoria para respaldos: genera una clave con `openssl rand -hex 32` y pégala aquí.
# Guarda la misma clave en todos los equipos que creen o restauren respaldos.
BACKUP_HMAC_KEY=CAMBIAR_POR_CLAVE_HEX_64
# (Opcional) Clave anterior de HMAC para validar respaldos firmados antes de la rotación.
# BACKUP_HMAC_KEY_PREVIOUS=CLAVE_ANTERIOR_HEX_64
# Opcionales para sobreescribir la configuración JDBC de la aplicación.
# DB_URL=jdbc:mysql://127.0.0.1:3306/restaurante?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=restaurante_app
# DB_PASSWORD=CAMBIAR_POR_CLAVE_LOCAL_APP
# ── Impresión de Tickets ──────────────────────────────────────────────────────
# Modo de salida del ticket/factura. Valores reconocidos:
#   IMPRIMIR  → impresión directa y silenciosa a la tickera (por defecto).
#   VISOR     → siempre abre el PDF en el visor del sistema (útil para pantallas sin impresora física).
#   AUTO      → intenta impresión directa; si falla, degrada a visor.
# ACCION_IMPRESION=IMPRIMIR
# Nombre exacto de la tickera instalada en el sistema (ej. "XP-80T", "Xprinter XP-80T").
# Si no se define o se deja "DEFAULT", usa la impresora predeterminada de Windows/CUPS.
# IMPRESORA_TICKETS=DEFAULT
