# Copia este archivo a .env y cambia las contraseñas para tu entorno local.
MYSQL_DATABASE=restaurante
MYSQL_USER=restaurante_app
MYSQL_PASSWORD=CAMBIAR_POR_CLAVE_LOCAL_APP
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_CLAVE_LOCAL_ROOT
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Obligatoria para respaldos: genera una clave con `openssl rand -hex 32` y pégala aquí.
# Guarda la misma clave en todos los equipos que creen o restauren respaldos.
BACKUP_HMAC_KEY=CAMBIAR_POR_CLAVE_HEX_64
# Opcionales para sobreescribir la configuración JDBC de la aplicación.
# DB_URL=jdbc:mysql://127.0.0.1:3306/restaurante?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=restaurante_app
# DB_PASSWORD=CAMBIAR_POR_CLAVE_LOCAL_APP
